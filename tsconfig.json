{
  "extends": "plasmo/templates/tsconfig.base",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".plasmo/index.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".plasmo"
  ]
}
