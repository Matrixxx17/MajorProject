{
    "manifest_version": 3,
    "name": "Test Generator Extension",
    "version": "1.0",
    "description": "Upload a ZIP file to generate tests with context.",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "permissions": [],
    "host_permissions": [
        "http://localhost:5000/*"
    ]
}