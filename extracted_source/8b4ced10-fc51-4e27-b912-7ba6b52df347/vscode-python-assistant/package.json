{
  "name": "python-assistant",
  "displayName": "Python Assistant - Test Gen & Refactor",
  "description": "AI-powered test generation and code refactoring for Python",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "python-assistant-container",
          "title": "Python Assistant",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "python-assistant-container": [
        {
          "type": "webview",
          "id": "python-assistant.assistantView",
          "name": "Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "python-assistant.openView",
        "title": "Open Python Assistant",
        "category": "Python Assistant"
      }
    ],
    "configuration": {
      "title": "Python Assistant",
      "properties": {
        "pythonAssistant.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend API URL"
        },
        "pythonAssistant.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL for test refinement"
        },
        "pythonAssistant.defaultModel": {
          "type": "string",
          "default": "Salesforce/codet5p-770m",
          "enum": [
            "Salesforce/codet5p-770m",
            "Salesforce/codet5p-2b",
            "bigcode/starcoderbase"
          ],
          "description": "Default refactoring model"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.x",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
